# CPU V3 two-stage flash boot package for the cpu_v3_system example.
# Section files are the exact compiler outputs consumed by the system build.
# Materialize and independently repack them with:
#   cargo run -p cpu-v3-tang-nano-20k --bin cpu-v3-boot-assets
#   cargo run -p cpu-v3-tang-nano-20k --bin cpu-v3-pack -- systems/cpu-v3-tang-nano-20k/examples/cpu_v3_system/boot.cpu-v3-manifest -o target/cpu-v3-boot/cpu-v3-boot.repacked.bin
format 1
target tang-nano-20k
stage1-section stage1
stage1-entry 0x0001 0x0100 0x0002 0xf000
application-entry 0x0003 0x0200 0x0004 0xe000

load stage1         0x00010100 rx 32 1334 ../../../../target/cpu-v3-boot/stage1.v3bin
load application    0x00030200 rx 32 218 ../../../../target/cpu-v3-boot/boot-demo.v3bin
load application-alt 0x00050200 rx 32 188 ../../../../target/cpu-v3-boot/boot-alt.v3bin
load data        0x00040000 rw 32 8 ../../../../target/cpu-v3-boot/data.bin
zero bss         0x00040100 rw 32 64
