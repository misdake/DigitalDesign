// Trusted fixture extension, not a production graphics API. Real RCC/native
// encoders append three copies to the already prepared small renderer stream.
fn profiling_native_tail(mut cb: Array<GpuBuffer>) -> bool {
    let mut memory: Buf<u16, 128> = Buf::new([0; 128]);
    let begin = memory.as_ptr();
    let p = begin.add((((begin.addr() + 63) & 65472) - begin.addr()) as i16);
    let mut storage: GpuStorage = GpuStorage {
        cpu: p,
        sector: 0xf400,
        sectors: 1,
    };
    if !gpu_encode_memcpy(view_of(&mut storage), 0, 0xe000, 0xe200, 8)
        || !gpu_encode_memcpy(view_of(&mut storage), 16, 0xe200, 0xe400, 8)
        || !gpu_encode_memcpy(view_of(&mut storage), 32, 0xe01c, 0xe41c, 8)
    {
        return false;
    }
    unsafe {
        p.write(4, 0x6a6a);
        p.write(20, 0x5b5b);
        p.write(36, 0x4c4c);
    }
    let mut parts: GpuWindowParts = GpuWindowParts {
        first: p,
        count: 64,
        tail: p,
        tail_count: 0,
    };
    if !gpu_window_parts_mode(view_of(&mut parts), 0xf400, 0, false, true) {
        return false;
    }
    let mut sector: u16 = 0xe000;
    while sector < 0xe024 {
        let mut i: u16 = 0;
        while i < 64 {
            unsafe {
                p.write(i as i16, (sector - 0xe000) * 64 + i + 0x1234);
            }
            i += 1;
        }
        if !gpu_window_parts_mode(view_of(&mut parts), sector, 0, false, true) {
            return false;
        }
        sector += 1;
    }
    // Native copies require the existing explicit cache/pipeline fence.
    if !gpu_command_fixed(p, 7, 0, 0)
        || !gpu_command_dma(p.add(2), 0, 0x7a, 264, 128)
        || !gpu_command_fixed(p.add(4), 4, 1, 0)
        || !gpu_encode_memcpy_command(view_of(&mut storage), 6, 66)
        || !gpu_encode_memcpy_command(view_of(&mut storage), 8, 67)
        || !gpu_encode_memcpy_command(view_of(&mut storage), 10, 68)
        || !gpu_command_fixed(p.add(12), 15, 0, 0)
    {
        return false;
    }
    parts.count = 14;
    let end = cb[0u16].command_words - 2;
    if !gpu_window_parts_mode(
        view_of(&mut parts),
        cb[0u16].commands.sector,
        end,
        false,
        true,
    ) {
        return false;
    }
    cb[0u16].command_words += 12;
    GPU_DRIVER_SUBMISSION.count_minus_one += 6;
    true
}
