# G16 two-stage flash boot package for the g16_boot example.
# Section files are compiler outputs; regenerate with:
#   rcc cpu_v2/src/dsl_progs/stage1_dsl.rs --g16 --code-base 0x100 --stack-init 0xf000 -o target/g16_boot/stage1.g16bin
#   rcc cpu_v2/src/dsl_progs/boot_demo_dsl.rs --g16 --code-base 0x200 --stack-init 0xe000 -o target/g16_boot/boot_demo.g16bin
#   printf '\xef\xbe\x55' > target/g16_boot/data.bin
#   g16-pack hardware/examples/g16_boot/boot.g16manifest -o target/g16_boot/g16_boot.bin
format 1
target tang-nano-20k
stage1-section stage1
stage1-entry 0x0001 0x0100 0x0002 0xf000
application-entry 0x0003 0x0200 0x0004 0xe000

load stage1      0x00010100 rx 32 1268 ../../../target/g16_boot/stage1.g16bin
load application 0x00030200 rx 32 118 ../../../target/g16_boot/boot_demo.g16bin
load data        0x00040000 rw 32 8 ../../../target/g16_boot/data.bin
zero bss         0x00040100 rw 32 64
