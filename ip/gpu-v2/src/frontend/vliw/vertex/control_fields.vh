// Shared72-bit ROM: retain the original low50 Vertex fields.
wire [1:0] l_src_raw = control[1:0];
wire [1:0] r_src_raw = control[3:2];
wire [4:0] u_off_raw = control[8:4];
wire [1:0] cfg_off_raw = control[10:9];
wire [0:0] swap_raw = control[11:11];
wire [1:0] up_push_raw = control[13:12];
wire [0:0] cfg_we_raw = control[14:14];
wire [1:0] cfg_idx_raw = control[16:15];
wire [3:0] rf_dst_raw = control[20:17];
wire [3:0] rf_mac_raw = control[24:21];
wire [3:0] rf_pack_raw = control[28:25];
wire [1:0] rf_wsrc_raw = control[30:29];
wire [0:0] mul_en_raw = control[31:31];
wire [1:0] acc_op_raw = control[33:32];
wire [0:0] wb_normal_raw = control[34:34];
wire [2:0] pack_op_raw = control[37:35];
wire [1:0] emit_raw = control[39:38];
wire [2:0] flow_raw = control[42:40];
wire [6:0] target_raw = control[49:43];
wire [0:0] up_hi_raw = control[50:50];
wire [1:0] target_hi_raw = control[52:51];
wire [0:0] work_en_raw = control[53:53];
wire [0:0] work_we_raw = control[54:54];
wire [5:0] work_addr_raw = control[60:55];
wire [2:0] up_push={up_hi_raw,up_push_raw};
wire [8:0] target={target_hi_raw,target_raw};
wire [1:0] l_src=l_src_raw;
wire [1:0] r_src=r_src_raw;
wire [4:0] u_off=u_off_raw;
wire [1:0] cfg_off=cfg_off_raw;
wire [0:0] swap=swap_raw;
wire [0:0] cfg_we=cfg_we_raw;
wire [1:0] cfg_idx=cfg_idx_raw;
wire [3:0] rf_dst=rf_dst_raw;
wire [3:0] rf_mac=rf_mac_raw;
wire [3:0] rf_pack=rf_pack_raw;
wire [1:0] rf_wsrc=rf_wsrc_raw;
wire [0:0] mul_en=mul_en_raw;
wire [1:0] acc_op=acc_op_raw;
wire [0:0] wb_normal=wb_normal_raw;
wire [2:0] pack_op=pack_op_raw;
wire [1:0] emit=emit_raw;
wire [2:0] flow=flow_raw;
wire [0:0] work_en=work_en_raw;
wire [0:0] work_we=work_we_raw;
wire [5:0] work_addr=work_addr_raw;
